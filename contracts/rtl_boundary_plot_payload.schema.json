{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/rtl_boundary_plot_payload.schema.json",
  "title": "RTL boundary benchmark plot payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "source_adjudication_sha256",
    "experiment_id",
    "target_id",
    "sweep_space_sha256",
    "action_domain_sha256",
    "point_count",
    "selector_rows",
    "backend_rows"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "rtl_boundary_plot_payload"},
    "source_adjudication_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "sweep_space_sha256": {"$ref": "#/$defs/sha256"},
    "action_domain_sha256": {"$ref": "#/$defs/sha256"},
    "point_count": {"type": "integer", "minimum": 1},
    "selector_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "backend_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestone": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled_state_evals",
        "unique_state_evals",
        "duplicate_state_evals",
        "bad_search_state_evals",
        "fixed_confirmation_state_evals",
        "cycle_evals",
        "batch_launches",
        "wall_time_ns"
      ],
      "properties": {
        "scheduled_state_evals": {"type": "integer", "minimum": 0},
        "unique_state_evals": {"type": "integer", "minimum": 0},
        "duplicate_state_evals": {"type": "integer", "minimum": 0},
        "bad_search_state_evals": {"type": "integer", "minimum": 0},
        "fixed_confirmation_state_evals": {"type": "integer", "minimum": 0},
        "cycle_evals": {"type": "integer", "minimum": 0},
        "batch_launches": {"type": "integer", "minimum": 0},
        "wall_time_ns": {"type": "integer", "minimum": 0}
      }
    },
    "ratio": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["computed", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "value": {"type": "number"}
      },
      "additionalProperties": false
    },
    "distance": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["computed", "not_applicable", "unbounded"]},
        "reason": {"type": "string", "minLength": 1},
        "ordinal_distance": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "comparison_kind",
        "trial_id",
        "policy_kind",
        "backend_id",
        "backend_kind",
        "resident_width",
        "logical_bad_queries",
        "accounting",
        "first_violation_logical_bad_queries",
        "first_bracket_logical_bad_queries",
        "first_exact_boundary_logical_bad_queries",
        "boundary_precision",
        "boundary_recall",
        "boundary_hausdorff",
        "failure_region_iou",
        "minimal_failing_point_recovery"
      ],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "comparison_kind": {"enum": ["selector", "backend"]},
        "trial_id": {"type": "string", "minLength": 1},
        "policy_kind": {"type": "string", "minLength": 1},
        "backend_id": {"type": "string", "minLength": 1},
        "backend_kind": {"enum": ["cpu", "gpu"]},
        "resident_width": {"type": "integer", "minimum": 1},
        "logical_bad_queries": {"type": "integer", "minimum": 0},
        "accounting": {"$ref": "#/$defs/accounting"},
        "first_violation_logical_bad_queries": {"$ref": "#/$defs/milestone"},
        "first_bracket_logical_bad_queries": {"$ref": "#/$defs/milestone"},
        "first_exact_boundary_logical_bad_queries": {"$ref": "#/$defs/milestone"},
        "boundary_precision": {"$ref": "#/$defs/ratio"},
        "boundary_recall": {"$ref": "#/$defs/ratio"},
        "boundary_hausdorff": {"$ref": "#/$defs/distance"},
        "failure_region_iou": {"$ref": "#/$defs/ratio"},
        "minimal_failing_point_recovery": {"$ref": "#/$defs/ratio"}
      }
    }
  }
}
