{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_regression_adjudication.schema.json",
  "title": "OpenTitan regression adjudication output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "target_id",
    "status",
    "verified_identity",
    "checks",
    "issue_count",
    "issues",
    "verified_artifacts",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_regression_adjudication"
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "verified_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/verified_identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "target_contract": {
      "$ref": "opentitan_regression_target_contract_report.schema.json"
    },
    "verified_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifacts",
        "graph_artifacts",
        "report_artifacts"
      ],
      "properties": {
        "source_artifacts": {
          "$ref": "#/$defs/artifact_rows"
        },
        "graph_artifacts": {
          "$ref": "#/$defs/artifact_rows"
        },
        "report_artifacts": {
          "$ref": "#/$defs/artifact_rows"
        }
      }
    },
    "input_sha256": {
      "$ref": "#/$defs/input_sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "pass"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "input_sha256": {
            "required": ["target_contract", "evidence"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "verified_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "ip",
        "issue",
        "revisions",
        "checkpoint_identity",
        "oracle_identity",
        "campaign_action_domain",
        "campaign_action_domain_sha256",
        "reproduction_action_domain",
        "reproduction_action_domain_sha256",
        "semantic_observables",
        "oracle_field",
        "semantic_manifest_sha256"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ip": {
          "$ref": "#/$defs/nonempty_string"
        },
        "issue": {
          "$ref": "#/$defs/nonempty_string"
        },
        "revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bad", "fixed"],
          "properties": {
            "bad": {"$ref": "#/$defs/sha1"},
            "fixed": {"$ref": "#/$defs/sha1"}
          }
        },
        "checkpoint_identity": {
          "$ref": "#/$defs/nonempty_string"
        },
        "oracle_identity": {
          "$ref": "#/$defs/nonempty_string"
        },
        "campaign_action_domain": {
          "$ref": "#/$defs/string_set"
        },
        "campaign_action_domain_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reproduction_action_domain": {
          "$ref": "#/$defs/string_set"
        },
        "reproduction_action_domain_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_observables": {
          "$ref": "#/$defs/string_set"
        },
        "oracle_field": {
          "$ref": "#/$defs/nonempty_string"
        },
        "semantic_manifest_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bad", "fixed"],
          "properties": {
            "bad": {"$ref": "#/$defs/sha256"},
            "fixed": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "issue_codes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "artifact_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "payload_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "source_artifact_roles": {
            "$ref": "#/$defs/string_set"
          },
          "source_artifact_sha256_by_role": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_spec": {"$ref": "#/$defs/sha256"},
        "target_contract": {"$ref": "#/$defs/sha256"},
        "evidence": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
