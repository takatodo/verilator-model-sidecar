{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/rtl_boundary_analysis.schema.json",
  "title": "Derived RTL boundary ground-truth analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "sweep_space_sha256",
    "axes",
    "point_count",
    "observations",
    "revisions",
    "bad_to_fixed"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "rtl_boundary_analysis"},
    "sweep_space_sha256": {"$ref": "#/$defs/sha256"},
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_sweep_space.schema.json#/$defs/axis"
      }
    },
    "point_count": {"type": "integer", "minimum": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_ground_truth.schema.json#/$defs/observation"
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bad", "fixed"],
      "properties": {
        "bad": {"$ref": "#/$defs/revision_analysis"},
        "fixed": {"$ref": "#/$defs/revision_analysis"}
      }
    },
    "bad_to_fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disappeared_failure_point_ids",
        "persistent_failure_point_ids",
        "introduced_failure_point_ids"
      ],
      "properties": {
        "disappeared_failure_point_ids": {"$ref": "#/$defs/point_id_set"},
        "persistent_failure_point_ids": {"$ref": "#/$defs/point_id_set"},
        "introduced_failure_point_ids": {"$ref": "#/$defs/point_id_set"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point_id": {
      "type": "string",
      "pattern": "^point:v1:[0-9a-f]{64}$"
    },
    "point_id_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/point_id"}
    },
    "boundary_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "axis_kind",
        "pass_point_id",
        "fail_point_id"
      ],
      "properties": {
        "axis": {"type": "string", "minLength": 1},
        "axis_kind": {"enum": ["ordered", "categorical"]},
        "pass_point_id": {"$ref": "#/$defs/point_id"},
        "fail_point_id": {"$ref": "#/$defs/point_id"}
      }
    },
    "failure_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "point_ids"],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^failure-component:v1:[0-9a-f]{64}$"
        },
        "point_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/point_id"}
        }
      }
    },
    "minimal_failing_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "point_ids"],
      "properties": {
        "status": {"enum": ["computed", "not_applicable"]},
        "point_ids": {"$ref": "#/$defs/point_id_set"}
      }
    },
    "revision_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_point_count",
        "fail_point_count",
        "pass_point_ids",
        "fail_point_ids",
        "boundary_edge_count",
        "boundary_edges",
        "failure_component_count",
        "failure_components",
        "minimal_failing_points"
      ],
      "properties": {
        "pass_point_count": {"type": "integer", "minimum": 0},
        "fail_point_count": {"type": "integer", "minimum": 0},
        "pass_point_ids": {"$ref": "#/$defs/point_id_set"},
        "fail_point_ids": {"$ref": "#/$defs/point_id_set"},
        "boundary_edge_count": {"type": "integer", "minimum": 0},
        "boundary_edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundary_edge"}
        },
        "failure_component_count": {"type": "integer", "minimum": 0},
        "failure_components": {
          "type": "array",
          "items": {"$ref": "#/$defs/failure_component"}
        },
        "minimal_failing_points": {"$ref": "#/$defs/minimal_failing_points"}
      }
    }
  }
}
