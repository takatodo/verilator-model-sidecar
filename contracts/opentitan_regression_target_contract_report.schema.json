{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_regression_target_contract_report.schema.json",
  "title": "OpenTitan regression target-contract report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "status",
    "checks",
    "target_count",
    "issue_count",
    "issues",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_regression_target_contract_report"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "target_count": {
      "type": "integer",
      "minimum": 0
    },
    "issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "input_sha256": {
      "$ref": "#/$defs/input_sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "pass"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "target_count": {"minimum": 1},
          "targets": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "issue_codes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "target_id",
        "status",
        "issue_count"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  }
}
