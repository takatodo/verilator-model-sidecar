{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/rtl_boundary_sweep_enumeration.schema.json",
  "title": "Canonical finite RTL sweep enumeration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "sweep_space_sha256",
    "axes",
    "point_count",
    "points"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "rtl_boundary_sweep_enumeration"},
    "sweep_space_sha256": {"$ref": "#/$defs/sha256"},
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_sweep_space.schema.json#/$defs/axis"
      }
    },
    "point_count": {"type": "integer", "minimum": 1},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/point"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point_id": {
      "type": "string",
      "pattern": "^point:v1:[0-9a-f]{64}$"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_sweep_space.schema.json#/$defs/scalar"
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "parameters"],
      "properties": {
        "point_id": {"$ref": "#/$defs/point_id"},
        "parameters": {"$ref": "#/$defs/parameters"}
      }
    }
  }
}
