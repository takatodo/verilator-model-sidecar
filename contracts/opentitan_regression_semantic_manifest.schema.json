{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_regression_semantic_manifest.schema.json",
  "title": "OpenTitan regression semantic manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "target_id",
    "revision_label",
    "revision_sha",
    "checkpoint_identity",
    "oracle_identity",
    "observables"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_regression_semantic_manifest"
    },
    "target_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "revision_label": {
      "type": "string",
      "enum": ["bad", "fixed"]
    },
    "revision_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checkpoint_identity": {
      "$ref": "#/$defs/nonempty_string"
    },
    "oracle_identity": {
      "$ref": "#/$defs/nonempty_string"
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observable"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "semantic_id",
        "width_bits"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "semantic_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "width_bits": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
