{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_regression_adjudication_summary.schema.json",
  "title": "OpenTitan regression adjudication summary output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "status",
    "input_sha256",
    "evidence_count",
    "pass_count",
    "fail_count",
    "check_counts",
    "results"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_regression_adjudication_summary"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "input_sha256": {
      "$ref": "#/$defs/input_sha256"
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1
    },
    "pass_count": {
      "type": "integer",
      "minimum": 0
    },
    "fail_count": {
      "type": "integer",
      "minimum": 0
    },
    "check_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pass",
          "fail"
        ],
        "properties": {
          "pass": {
            "type": "integer",
            "minimum": 0
          },
          "fail": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "run_spec": {
      "$ref": "opentitan_regression_adjudication_run_spec_report.schema.json"
    },
    "target_contract": {
      "$ref": "opentitan_regression_target_contract_report.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "pass"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "input_sha256": {
            "required": ["target_contract"],
            "properties": {
              "target_contract": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_spec": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_contract": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "verified_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "ip",
        "issue",
        "revisions",
        "checkpoint_identity",
        "oracle_identity",
        "campaign_action_domain",
        "campaign_action_domain_sha256",
        "reproduction_action_domain",
        "reproduction_action_domain_sha256",
        "semantic_observables",
        "oracle_field",
        "semantic_manifest_sha256"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/nonempty_string"},
        "ip": {"$ref": "#/$defs/nonempty_string"},
        "issue": {"$ref": "#/$defs/nonempty_string"},
        "revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bad", "fixed"],
          "properties": {
            "bad": {"$ref": "#/$defs/sha1"},
            "fixed": {"$ref": "#/$defs/sha1"}
          }
        },
        "checkpoint_identity": {"$ref": "#/$defs/nonempty_string"},
        "oracle_identity": {"$ref": "#/$defs/nonempty_string"},
        "campaign_action_domain": {"$ref": "#/$defs/string_set"},
        "campaign_action_domain_sha256": {"$ref": "#/$defs/sha256"},
        "reproduction_action_domain": {"$ref": "#/$defs/string_set"},
        "reproduction_action_domain_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_observables": {"$ref": "#/$defs/string_set"},
        "oracle_field": {"$ref": "#/$defs/nonempty_string"},
        "semantic_manifest_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bad", "fixed"],
          "properties": {
            "bad": {"$ref": "#/$defs/sha256"},
            "fixed": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "evidence_path",
        "target_id",
        "status",
        "verified_identity",
        "issue_count",
        "issue_codes",
        "issues",
        "input_sha256"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "verified_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/verified_identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "issue_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "input_sha256": {
          "$ref": "#/$defs/input_sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "pass"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "input_sha256": {
                "required": ["target_contract", "evidence"],
                "properties": {
                  "target_contract": {"$ref": "#/$defs/sha256"},
                  "evidence": {"$ref": "#/$defs/sha256"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
