{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_regression_adjudication_run_spec.schema.json",
  "title": "OpenTitan regression adjudication run spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "target_contract",
    "evidence_root",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_regression_adjudication_run_spec"
    },
    "target_contract": {
      "$ref": "#/$defs/relative_path"
    },
    "evidence_root": {
      "$ref": "#/$defs/relative_path_or_dot"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_path"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.$)(?!.*(^|/)\\.\\.(/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "relative_path_or_dot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(\\.|(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\u0000-\\u001f\\u007f]+)$"
    }
  }
}
