{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/rtl_boundary_semantic_manifest.schema.json",
  "title": "RTL boundary semantic manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "target_id",
    "revision_label",
    "revision_sha",
    "checkpoint_identity",
    "oracle_identity",
    "observables"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "rtl_boundary_semantic_manifest"},
    "target_id": {"type": "string", "minLength": 1},
    "revision_label": {"enum": ["bad", "fixed"]},
    "revision_sha": {"$ref": "#/$defs/git_sha"},
    "checkpoint_identity": {"type": "string", "minLength": 1},
    "oracle_identity": {"type": "string", "minLength": 1},
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observable"}
    }
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "semantic_id", "width_bits"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "semantic_id": {"type": "string", "minLength": 1},
        "width_bits": {"type": "integer", "minimum": 1}
      }
    }
  }
}
