{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_regression_target_contract.schema.json",
  "title": "OpenTitan regression target contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_regression_target_contract"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "ip",
        "issue",
        "revisions",
        "checkpoint_identity",
        "oracle_identity",
        "campaign_action_domain",
        "reproduction_action_domain",
        "semantic_observables",
        "oracle_field",
        "semantic_manifest_sha256"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "ip": {
          "$ref": "#/$defs/nonempty_string"
        },
        "issue": {
          "$ref": "#/$defs/nonempty_string"
        },
        "revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bad",
            "fixed"
          ],
          "properties": {
            "bad": {
              "$ref": "#/$defs/sha1"
            },
            "fixed": {
              "$ref": "#/$defs/sha1"
            }
          }
        },
        "checkpoint_identity": {
          "$ref": "#/$defs/nonempty_string"
        },
        "oracle_identity": {
          "$ref": "#/$defs/nonempty_string"
        },
        "campaign_action_domain": {
          "$ref": "#/$defs/string_set"
        },
        "reproduction_action_domain": {
          "$ref": "#/$defs/string_set"
        },
        "semantic_observables": {
          "$ref": "#/$defs/string_set"
        },
        "oracle_field": {
          "$ref": "#/$defs/nonempty_string"
        },
        "semantic_manifest_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bad",
            "fixed"
          ],
          "properties": {
            "bad": {
              "$ref": "#/$defs/sha256"
            },
            "fixed": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
