{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/rtl_boundary_experiment_contract.schema.json",
  "title": "RTL boundary benchmark experiment Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "experiment_id",
    "target",
    "sweep_space",
    "sweep_space_sha256",
    "reconstructor",
    "backends",
    "trials",
    "comparisons"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "rtl_boundary_experiment_contract"},
    "experiment_id": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "sweep_space": {
      "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_sweep_space.schema.json"
    },
    "sweep_space_sha256": {"$ref": "#/$defs/sha256"},
    "reconstructor": {
      "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_policy_trial.schema.json#/$defs/reconstructor"
    },
    "backends": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/backend"}
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trial"}
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/comparison"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "revision_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bad", "fixed"],
      "properties": {
        "bad": {"$ref": "#/$defs/git_sha"},
        "fixed": {"$ref": "#/$defs/git_sha"}
      }
    },
    "manifest_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bad", "fixed"],
      "properties": {
        "bad": {"$ref": "#/$defs/sha256"},
        "fixed": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "issue",
        "ip",
        "checkpoint_identity",
        "oracle_identity",
        "revisions",
        "semantic_observables",
        "oracle_field",
        "semantic_manifest_sha256"
      ],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "issue": {"type": "string", "minLength": 1},
        "ip": {"type": "string", "minLength": 1},
        "checkpoint_identity": {"type": "string", "minLength": 1},
        "oracle_identity": {"type": "string", "minLength": 1},
        "revisions": {"$ref": "#/$defs/revision_map"},
        "semantic_observables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "oracle_field": {"type": "string", "minLength": 1},
        "semantic_manifest_sha256": {"$ref": "#/$defs/manifest_map"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "kind", "executor_identity", "resident_width"],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["cpu", "gpu"]},
        "executor_identity": {"type": "string", "minLength": 1},
        "resident_width": {"type": "integer", "minimum": 1}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "backend_id",
        "policy",
        "requested_count",
        "budget_logical_bad_queries"
      ],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "backend_id": {"type": "string", "minLength": 1},
        "policy": {
          "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_policy_trial.schema.json#/$defs/policy"
        },
        "requested_count": {"type": "integer", "minimum": 1},
        "budget_logical_bad_queries": {"type": "integer", "minimum": 1}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "kind", "trial_ids"],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["selector", "backend"]},
        "trial_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
