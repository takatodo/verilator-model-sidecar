{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/opentitan_external_regression_evidence_bundle.schema.json",
  "title": "OpenTitan external regression evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "target_id",
    "target",
    "runner",
    "revisions",
    "checkpoint_identity",
    "oracle_identity",
    "action_domain",
    "action_domain_sha256",
    "semantic_manifest_sha256",
    "revision_results",
    "seed_corpora",
    "campaign",
    "source_artifacts",
    "graph_artifacts",
    "report_artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "opentitan_external_regression_evidence_bundle"
    },
    "target_id": {
      "$ref": "#/$defs/nonempty_string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip",
        "issue"
      ],
      "properties": {
        "ip": {
          "$ref": "#/$defs/nonempty_string"
        },
        "issue": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "status",
        "completed_at"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/nonempty_string"
        },
        "status": {
          "type": "string",
          "const": "pass"
        },
        "completed_at": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "revisions": {
      "$ref": "#/$defs/revision_map"
    },
    "checkpoint_identity": {
      "$ref": "#/$defs/nonempty_string"
    },
    "oracle_identity": {
      "$ref": "#/$defs/nonempty_string"
    },
    "action_domain": {
      "$ref": "#/$defs/string_set"
    },
    "action_domain_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "semantic_manifest_sha256": {
      "$ref": "#/$defs/semantic_manifest_map"
    },
    "revision_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bad",
        "fixed"
      ],
      "properties": {
        "bad": {
          "$ref": "#/$defs/revision_result"
        },
        "fixed": {
          "$ref": "#/$defs/revision_result"
        }
      }
    },
    "seed_corpora": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_gain",
        "oracle_violation"
      ],
      "properties": {
        "coverage_gain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coverage_gain_seed"
          }
        },
        "oracle_violation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/oracle_violation_seed"
          }
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policies"
      ],
      "properties": {
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/campaign_policy"
          }
        }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_artifact"
      }
    },
    "graph_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/payload_artifact"
      }
    },
    "report_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/payload_artifact"
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lowercase_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "action_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "revision_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bad",
        "fixed"
      ],
      "properties": {
        "bad": {
          "$ref": "#/$defs/sha1"
        },
        "fixed": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "semantic_manifest_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bad",
        "fixed"
      ],
      "properties": {
        "bad": {
          "$ref": "#/$defs/sha256"
        },
        "fixed": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "projection": {
      "type": "object",
      "minProperties": 1
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "status",
        "cpu",
        "gpu"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/action_sequence"
        },
        "status": {
          "type": "string",
          "const": "pass"
        },
        "cpu": {
          "$ref": "#/$defs/projection"
        },
        "gpu": {
          "$ref": "#/$defs/projection"
        }
      }
    },
    "revision_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_action_sequences",
        "oracle_failure_action_sequences",
        "observations"
      ],
      "properties": {
        "executed_action_sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_sequence"
          }
        },
        "oracle_failure_action_sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_sequence"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "coverage_gain_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_kind",
        "source_revision",
        "sequence",
        "coverage_delta_bits"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "corpus_kind": {
          "type": "string",
          "const": "coverage_gain"
        },
        "source_revision": {
          "type": "string",
          "enum": [
            "bad",
            "fixed"
          ]
        },
        "sequence": {
          "$ref": "#/$defs/action_sequence"
        },
        "coverage_delta_bits": {
          "$ref": "#/$defs/lowercase_hex"
        }
      }
    },
    "oracle_violation_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_kind",
        "source_revision",
        "sequence",
        "minimal"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "corpus_kind": {
          "type": "string",
          "const": "oracle_violation"
        },
        "source_revision": {
          "type": "string",
          "const": "bad"
        },
        "sequence": {
          "$ref": "#/$defs/action_sequence"
        },
        "minimal": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "campaign_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "orders",
        "metrics"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "orders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action_sequence"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mean",
            "p50",
            "p95",
            "max",
            "long_tail_rate"
          ],
          "properties": {
            "mean": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "p50": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "p95": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "long_tail_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/nonempty_string"
        },
        "path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "payload_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "payload",
        "payload_sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/nonempty_string"
        },
        "path": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload": {
          "$ref": "#/$defs/artifact_payload"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact_payload": {
      "type": "object",
      "minProperties": 1,
      "dependentRequired": {
        "source_artifact_role": [
          "source_artifact_sha256"
        ],
        "source_artifact_sha256": [
          "source_artifact_role"
        ],
        "source_artifact_roles": [
          "source_artifact_sha256_by_role"
        ],
        "source_artifact_sha256_by_role": [
          "source_artifact_roles"
        ]
      },
      "anyOf": [
        {
          "required": [
            "source_artifact_role",
            "source_artifact_sha256"
          ]
        },
        {
          "required": [
            "source_artifact_roles",
            "source_artifact_sha256_by_role"
          ]
        }
      ],
      "properties": {
        "source_artifact_role": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_artifact_roles": {
          "$ref": "#/$defs/string_set"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_artifact_sha256_by_role": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
