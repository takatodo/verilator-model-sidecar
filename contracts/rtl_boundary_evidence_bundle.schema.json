{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verilator-model-sidecar/rtl_boundary_evidence_bundle.schema.json",
  "title": "Externally generated RTL boundary benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "experiment_contract_sha256",
    "runner",
    "semantic_manifests",
    "ground_truth",
    "semantic_observations",
    "trials"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "surface": {"type": "string", "const": "rtl_boundary_evidence_bundle"},
    "experiment_contract_sha256": {"$ref": "#/$defs/sha256"},
    "runner": {"$ref": "#/$defs/runner"},
    "semantic_manifests": {"$ref": "#/$defs/manifests"},
    "ground_truth": {
      "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_ground_truth.schema.json"
    },
    "semantic_observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/semantic_observation"}
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point_id": {"type": "string", "pattern": "^point:v1:[0-9a-f]{64}$"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "identity", "completed_at"],
      "properties": {
        "status": {"const": "pass"},
        "identity": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "minLength": 1}
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bad", "fixed"],
      "properties": {
        "bad": {
          "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_semantic_manifest.schema.json"
        },
        "fixed": {
          "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_semantic_manifest.schema.json"
        }
      }
    },
    "projection": {
      "type": "object",
      "minProperties": 2
    },
    "revision_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "gpu"],
      "properties": {
        "cpu": {"$ref": "#/$defs/projection"},
        "gpu": {"$ref": "#/$defs/projection"}
      }
    },
    "semantic_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "revisions"],
      "properties": {
        "point_id": {"$ref": "#/$defs/point_id"},
        "revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bad", "fixed"],
          "properties": {
            "bad": {"$ref": "#/$defs/revision_projection"},
            "fixed": {"$ref": "#/$defs/revision_projection"}
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "epoch_index", "fixed_oracle"],
      "properties": {
        "point_id": {"$ref": "#/$defs/point_id"},
        "epoch_index": {"type": "integer", "minimum": 0},
        "fixed_oracle": {"type": "integer", "enum": [0, 1]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "epoch_index",
        "point_id",
        "revision",
        "purpose",
        "launch_id",
        "cycle_evals"
      ],
      "properties": {
        "execution_id": {"type": "string", "minLength": 1},
        "epoch_index": {"type": "integer", "minimum": 0},
        "point_id": {"$ref": "#/$defs/point_id"},
        "revision": {"enum": ["bad", "fixed"]},
        "purpose": {"enum": ["bad_search", "fixed_confirmation"]},
        "launch_id": {"type": "string", "minLength": 1},
        "cycle_evals": {"type": "integer", "minimum": 0}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_id",
        "backend_id",
        "executor_identity",
        "resident_width",
        "execution_ids",
        "start_offset_ns",
        "end_offset_ns"
      ],
      "properties": {
        "launch_id": {"type": "string", "minLength": 1},
        "backend_id": {"type": "string", "minLength": 1},
        "executor_identity": {"type": "string", "minLength": 1},
        "resident_width": {"type": "integer", "minimum": 1},
        "execution_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "start_offset_ns": {"type": "integer", "minimum": 0},
        "end_offset_ns": {"type": "integer", "minimum": 0}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "policy_trial",
        "fixed_confirmations",
        "executions",
        "launches",
        "trial_wall_time_ns"
      ],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "policy_trial": {
          "$ref": "https://example.invalid/verilator-model-sidecar/rtl_boundary_policy_trial.schema.json"
        },
        "fixed_confirmations": {
          "type": "array",
          "items": {"$ref": "#/$defs/confirmation"}
        },
        "executions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/execution"}
        },
        "launches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/launch"}
        },
        "trial_wall_time_ns": {"type": "integer", "minimum": 0}
      }
    }
  }
}
